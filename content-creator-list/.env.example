# Backend API base URL — Express server lives at ../src/app.js
# The Next.js rewrites in next.config.ts forward /api/* to here,
# stripping the /api prefix to match the Express routes.
#
# Local dev with backend on default port 3000:
API_PROXY_TARGET=http://localhost:3000

# Inside docker-compose, the frontend reaches the API service by name:
# API_PROXY_TARGET=http://api:3000
