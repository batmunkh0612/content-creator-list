# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=influencer_analytics
DATABASE_URL=postgresql://app:app@postgres:5432/influencer_analytics?schema=public

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Optional: a single rediss://user:pass@host:port URL (Upstash, Render Redis,
# etc.). When set, takes precedence over REDIS_HOST/PORT/PASSWORD and enables
# TLS automatically — required by managed Redis providers used in cloud
# deploys. Leave empty for the docker-compose dev setup.
REDIS_URL=

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Rate limit ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Cache ---
CACHE_TTL_SECONDS=300

# --- Worker ---
WORKER_CONCURRENCY=2
SCRAPER_HEADLESS=true

# --- Proxy rotation (comma-separated, optional) ---
# Format: http://user:pass@host:port,http://user:pass@host:port
PROXY_LIST=

# --- Instagram authenticated session (optional, but unlocks precise counts) ---
# Anonymous Instagram callers receive ROUNDED follower counts (e.g. 1,234,567
# → 1,000,000) for high-follower accounts. Setting these gets the exact count
# plus full latest-post engagement data.
#
# How to grab them:
#   1. Log into instagram.com from a throwaway account in your browser
#   2. DevTools → Application → Cookies → https://www.instagram.com
#   3. Copy the "sessionid" value here. ds_user_id is optional.
#
# WARNING: Use a throwaway account — Instagram can flag/ban accounts whose
# session is used for scraping.
IG_SESSIONID=
IG_DS_USER_ID=

# --- Multi-session pool (optional but recommended) ---
# Add IG_SESSIONID_1 / IG_DS_USER_ID_1 for a 2nd session, _2 for a 3rd, etc.
# (up to _9). The scraper round-robins between them and marks a session
# "cold" for 30 min when it sees a 429, automatically failing over to a
# live session. With 3 throwaways you get ~3× more headroom before
# Instagram's per-account throttle bites.
#
# IG_SESSIONID_1=
# IG_DS_USER_ID_1=
# IG_COOKIES_1=
# IG_WWW_CLAIM_1=

# --- Facebook session ---
# FB scraping is much harder than IG: anonymous traffic redirects to a
# login wall within a few seconds. Set FB_COOKIES to a logged-in browser's
# cookie jar (DevTools → Application → Cookies → www.facebook.com → copy
# the entire `Cookie` request header from any /api/graphql/* XHR). Must
# include `c_user`, `xs`, `fr`, `datr` at minimum.
#
# Optional but improves GraphQL reliability:
#   FB_USER_PK  — your account's actor PK (matches `c_user` cookie value)
#   FB_DTSG     — overrides the value the scraper otherwise extracts from
#                 the page HTML (auto-extracted, cached 5 min)
FB_COOKIES=
FB_USER_PK=
FB_DTSG=

# --- Neo4j (graph mirror) ---
# Optional. When enabled, every influencer scrape + each follower/following
# fetch mirrors into a Neo4j graph (label :Profile, edges [:FOLLOWS] with
# firstSeen/lastSeen timestamps). Browser UI at http://localhost:7474.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# --- Cloudflare Zero Trust Tunnel (optional) ---
# When set, the `cloudflared` service in docker-compose joins your tunnel
# and exposes the stack publicly without opening any inbound ports.
#
# How to get a token:
#   1. https://one.dash.cloudflare.com → Networks → Tunnels → Create a tunnel
#   2. Pick "Cloudflared" → name it → save
#   3. Copy the value AFTER `--token ` from the install snippet
#   4. In the same dashboard, "Public Hostname" tab → Add:
#        Subdomain: <whatever>     Domain: <your cf-managed domain>
#        Service: HTTP   URL: web:80
#
# CLOUDFLARE_TUNNEL_TOKEN=
